# Editoren / IDEs
.vscode/
.idea/
*.swp
*~

# Logs / temporäre Dateien
*.log
*.tmp

# Umgebungsvariablen / Secrets - NICHT committen!
.env
.env.local
.env.*.local
# Hinweis: config.js wird BEWUSST committet (nur Supabase-URL + Publishable-Key,
# beides oeffentlich unbedenklich; Schutz laeuft ueber RLS). Die echte .env bleibt raus.

# Lokale Hilfsdateien
qr.png
# Vorschau-Seite zum Aussuchen der Ladeanimation - NICHT deployen
preview/

.vercel
.env*

# design-sync: Bauergebnis, wird aus .design-sync/ neu erzeugt
ds-bundle/
node_modules/
# Nur der Wurzelordner migrations/ (lokale Arbeitskopie). Ohne den Schraegstrich
# am Anfang griff die Regel auch auf supabase/migrations/ - die Dateien ab 0031
# fielen dadurch still aus der Versionierung.
/migrations/

# design-sync: Messartefakte der Bildvergleiche, bleiben lokal
.design-sync/reference/compare/

# App-Landkarte: Bilder werden bei jedem Lauf neu erzeugt (versioniert sind
# nur landkarte.json und ab L3 landkarte.html)
.design-sync/landkarte/bilder/

# Design-Review 05.10.2026: iPhone-Screenshots des Nutzers, bleiben lokal
.design-sync/concepts/IMG_*

# Paket "Final Alle Screens": Ist- und Vergleichsbilder entstehen bei jedem Messlauf neu
.design-sync/concepts/final-2026-10/ist/
.design-sync/concepts/final-2026-10/vergleich/

# Lokale Claude-Rechte (nie committen)
.claude/settings.local.json

# Gerätematrix: Schriften und Befundbilder lokal (geraetematrix.mjs)
