{
  "crons": [
    { "path": "/api/sync-bfv", "schedule": "0 4 * * *" }
  ],
  "rewrites": [
    { "source": "/api/calendar/:token.ics", "destination": "/api/calendar?token=:token" },
    { "source": "/api/event/:token/:id.ics", "destination": "/api/event?token=:token&id=:id" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|json)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
